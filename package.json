{
  "name": "riptide",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@riptide/web' dev",
    "engine": "bun run --filter '@riptide/engine' start",
    "verify": "bun run --filter '@riptide/engine' verify",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.2",
    "typescript": "^5.6.0"
  }
}
